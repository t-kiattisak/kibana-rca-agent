# Environment Configuration for Kibana AI RCA Agent

# 1. Elasticsearch Connection
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=logs-app-*
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# 2. Poller & Alert Detection
POLL_INTERVAL_SECONDS=15
TIME_WINDOW_MINUTES=1
ERROR_THRESHOLD_COUNT=3

# 3. Gemini LLM Engine
# Replace with your actual Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. Notification Channels (Discord Webhook)
# Create a Webhook from Discord Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
